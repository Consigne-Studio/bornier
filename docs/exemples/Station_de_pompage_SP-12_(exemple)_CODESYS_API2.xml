          <type><INT /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Chlore libre en sortie | brut 0..32767 = 0..2 mg/l | carte AI2 voie 0</xhtml></documentation>
        </variable>
        <variable name="FT_201_BRUT" address="%IW1">
          <type><INT /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Débit eau traitée | brut 0..32767 = 0..250 m³/h | carte AI2 voie 1</xhtml></documentation>
        </variable>
        <variable name="DP_201_MAR" address="%IX4.0">
          <type><BOOL /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Pompe doseuse en marche | carte DI2 voie 0</xhtml></documentation>
        </variable>
        <variable name="DP_201_DEF" address="%IX4.1">
          <type><BOOL /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Pompe doseuse en défaut | carte DI2 voie 1</xhtml></documentation>
        </variable>
        <variable name="LSL_202" address="%IX4.2">
          <type><BOOL /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Niveau bas bidon d'hypochlorite | carte DI2 voie 2</xhtml></documentation>
        </variable>
        <variable name="DP_201_CMD" address="%QX2.0">
          <type><BOOL /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Commande pompe doseuse | carte DO2 voie 0</xhtml></documentation>
        </variable>
        <variable name="DP_201_CONS_BRUT" address="%QW0">
          <type><INT /></type>
          <documentation><xhtml xmlns="http://www.w3.org/1999/xhtml">Consigne de dosage | brut 0..32767 = 0..100 % | carte AO2 voie 0</xhtml></documentation>
        </variable>
        <variable name="CL_CONS">
          <type><REAL /></type>
